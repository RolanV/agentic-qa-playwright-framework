{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx playwright test:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run validate:*)",
      "Bash(npm run check:*)",
      "Bash(npm run create-test:*)",
      "Bash(npm run promote-test:*)",
      "Bash(npm run tracker -- list:*)",
      "Bash(npm run tracker -- show:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_close"
    ],
    "ask": [
      "Bash(npm run tracker -- move:*)",
      "Bash(npm run tracker -- comment:*)",
      "Bash(npm run tracker -- publish:*)",
      "Bash(npm run tracker -- update:*)",
      "Bash(npm run tracker -- create-task:*)",
      "Bash(npm run tracker -- notify:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(npm run tracker -- signoff:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "enabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/approval-gate.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-temp-commit.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-log.mjs\"" }
        ]
      }
    ]
  }
}
