# Copy to .env and adjust. Every URL/credential is read through src/config/env.ts — never hardcode them in tests.
BASE_URL=https://www.saucedemo.com
API_URL=https://restful-booker.herokuapp.com
# SauceDemo publishes its demo users on the login page; they are not secrets.
STANDARD_USER=standard_user
LOCKED_USER=locked_out_user
USER_PASSWORD=secret_sauce
# restful-booker demo admin
API_USER=admin
API_PASSWORD=password123
